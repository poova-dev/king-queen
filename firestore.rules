rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ====================================================
    // SECURITY HELPER FUNCTIONS
    // ====================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwnProfile(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Fetches the authoritative room document from Firestore
    function getRoomData(roomId) {
      return get(/databases/$(database)/documents/rooms/$(roomId)).data;
    }

    // Checks if the requester is verified as Player 1 or Player 2 inside rooms/{roomId}
    function isRoomParticipant(roomId) {
      let room = getRoomData(roomId);
      return isAuthenticated() && (
        room.players[0].uid == request.auth.uid ||
        (room.players.size() > 1 && room.players[1].uid == request.auth.uid)
      );
    }

    // Checks if the target userId is actually one of the players inside rooms/{roomId}
    function isUserInRoom(userId, roomId) {
      let room = getRoomData(roomId);
      return room.players[0].uid == userId ||
        (room.players.size() > 1 && room.players[1].uid == userId);
    }

    // ====================================================
    // USER PROFILES & GAME HISTORY
    // ====================================================

    match /users/{userId} {
      // Any authenticated user can view public player profiles
      allow read: if isAuthenticated();

      // Users can create only their own profile with valid identity and displayName
      allow create: if isOwnProfile(userId)
                    && request.resource.data.identity in ['KING', 'QUEEN']
                    && request.resource.data.displayName is string
                    && request.resource.data.displayName.size() >= 2
                    && request.resource.data.displayName.size() <= 30;

      // Users can update their own profile OR match participants can update stats upon match conclusion
      allow update: if isAuthenticated() && (
        (isOwnProfile(userId) && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'identity', 'bio', 'photoURL', 'updatedAt', 'wins', 'losses', 'gamesPlayed']))
        ||
        (request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['wins', 'losses', 'gamesPlayed', 'updatedAt']))
      );

      allow delete: if false;

      // User Game History Subcollection
      match /gameHistory/{gameId} {
        // Authenticated users can read ONLY their own personal game history
        allow read: if isOwnProfile(userId);

        // Created by user themselves OR by their match opponent through the authoritative completion transaction
        allow create: if isAuthenticated() && (
          isOwnProfile(userId) ||
          (
            request.resource.data.roomId is string &&
            isRoomParticipant(request.resource.data.roomId) &&
            isUserInRoom(userId, request.resource.data.roomId) &&
            request.resource.data.opponentUid == request.auth.uid
          )
        );

        // Historical battle records are immutable
        allow update, delete: if false;
      }
    }

    // ====================================================
    // PRIVATE MULTIPLAYER ROOMS
    // ====================================================

    match /rooms/{roomId} {
      // Authenticated users can query or subscribe to rooms
      allow read: if isAuthenticated();

      // Only the host can create a new room, initializing in WAITING with 1 player
      allow create: if isAuthenticated()
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.maxPlayers == 2
                    && request.resource.data.status == 'WAITING'
                    && request.resource.data.players.size() == 1
                    && request.resource.data.players[0].uid == request.auth.uid;

      // State transitions:
      // Case A: A new player joins an open WAITING room (players.size() < 2)
      // Case B: Existing verified room participant updates the room state
      allow update: if isAuthenticated() && (
        (resource.data.status == 'WAITING' && resource.data.players.size() < 2)
        ||
        (resource.data.players[0].uid == request.auth.uid ||
         (resource.data.players.size() > 1 && resource.data.players[1].uid == request.auth.uid))
      );

      allow delete: if false;

      // ── In-game emoji reactions (Phase A) ──────────────────────────
      match /reactions/{reactionId} {
        // Only room participants can read or create reactions
        allow read: if isRoomParticipant(roomId);
        allow create: if isRoomParticipant(roomId)
                      && request.resource.data.uid == request.auth.uid;
        // Reactions are permanent once written; no edit/delete
        allow update, delete: if false;
      }
    }

    // ====================================================
    // TRUTH OR DARE MULTIPLAYER ROOMS (STEP 18.2)
    // ====================================================

    function isTruthDareRoomParticipant(roomData) {
      return isAuthenticated() && (
        roomData.players[0].uid == request.auth.uid ||
        (roomData.players.size() > 1 && roomData.players[1].uid == request.auth.uid)
      );
    }

    match /truthDareRooms/{roomId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated()
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.gameType == 'TRUTH_DARE'
                    && request.resource.data.maxPlayers == 2
                    && request.resource.data.status == 'WAITING'
                    && request.resource.data.players.size() == 1
                    && request.resource.data.players[0].uid == request.auth.uid;

      allow update: if isAuthenticated() && (
        (resource.data.status == 'WAITING' && resource.data.players.size() < 2)
        ||
        isTruthDareRoomParticipant(resource.data)
      );

      allow delete: if false;
    }

    // ====================================================
    // TRUTH OR DARE CUSTOM DECKS (PHASE D)
    // ====================================================

    match /truthDareDecks/{deckId} {
      // Authenticated users can read public decks or their own private decks
      allow read: if isAuthenticated() && (
        resource.data.visibility == 'PUBLIC' ||
        resource.data.ownerUid == request.auth.uid
      );

      // Users can create decks only for themselves
      allow create: if isAuthenticated()
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.title is string
                    && request.resource.data.title.size() >= 1;

      // Only deck owner can update or delete their deck
      allow update: if isAuthenticated()
                    && resource.data.ownerUid == request.auth.uid
                    && request.resource.data.ownerUid == request.auth.uid;

      allow delete: if isAuthenticated()
                    && resource.data.ownerUid == request.auth.uid;
    }

    // ====================================================
    // PERMANENT GLOBAL GAME RECORDS
    // ====================================================

    match /games/{gameId} {
      // Only match participants can view the full board replay record
      allow read: if isAuthenticated()
                  && (request.auth.uid in resource.data.playerUids);

      // Authenticated participants can create a game record for their match
      allow create: if isAuthenticated()
                    && (request.auth.uid in request.resource.data.playerUids)
                    && request.resource.data.playerUids.size() == 2
                    && request.resource.data.roomId is string
                    && isRoomParticipant(request.resource.data.roomId);

      // Records are permanent and immutable
      allow update, delete: if false;
    }
  }
}



