rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // User profiles
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId
                    && request.resource.data.identity in ['KING', 'QUEEN']
                    && request.resource.data.displayName is string
                    && request.resource.data.displayName.size() >= 2
                    && request.resource.data.displayName.size() <= 30;
      allow update: if request.auth != null && request.auth.uid == userId
                    && (request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['displayName', 'identity', 'bio', 'photoURL', 'updatedAt', 'wins', 'losses', 'gamesPlayed']));
      allow delete: if false;
    }

    // Private game rooms
    match /rooms/{roomId} {
      // Any authenticated user can read or query rooms (e.g. check code uniqueness, join by code, subscribe)
      allow read: if request.auth != null;

      // Authenticated users can create a new room with themselves as creator
      allow create: if request.auth != null
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.maxPlayers == 2
                    && request.resource.data.status == 'WAITING'
                    && request.resource.data.players.size() == 1
                    && request.resource.data.players[0].uid == request.auth.uid;

      // Allow room participants to update or an unjoined user to join an open room
      allow update: if request.auth != null
                    && (
                      // Case A: A new player joins an open room
                      (resource.data.status == 'WAITING' && resource.data.players.size() < 2)
                      ||
                      // Case B: Existing room participant updates state
                      (resource.data.players[0].uid == request.auth.uid ||
                       (resource.data.players.size() > 1 && resource.data.players[1].uid == request.auth.uid))
                    );

      allow delete: if false; // Soft-delete only via CANCELLED
    }
  }
}
